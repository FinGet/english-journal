# Optional DeepFilterNet executable. The denoise command reads this file as .env.
# DEEP_FILTER_BIN=/absolute/path/to/deep-filter

# Transcription uses --model or an exported shell variable, not this .env file.
# export LOCAL_ASR_MODEL=/absolute/path/to/whisper-large-v3-turbo

# Feishu app credentials (or use existing shell environment variables).
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# Optional: pin the journal group ID. If absent, resolve the unique group named journal.
# JOURNAL_FEISHU_CHAT_ID=oc_your_journal_group_id
